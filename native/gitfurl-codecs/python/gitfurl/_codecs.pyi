class CmOutput:
    left: int
    def __len__(self) -> int: ...
    def take(self, n: int) -> bytes: ...

def cm_header(head: bytes) -> tuple[int, int]: ...
def cm_decode(data: bytes, threads: int = 1) -> bytes: ...
